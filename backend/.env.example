# MongoDB Atlas connection string
MONGO_URL=mongodb+srv://USERNAME:PASSWORD@YOUR-CLUSTER.mongodb.net/?retryWrites=true&w=majority
DB_NAME=optinexus
# Generate a long random secret; do not reuse a password.
JWT_SECRET=replace-with-a-long-random-secret
# Comma-separated frontend origins. Use * only for temporary testing.
CORS_ORIGINS=https://your-frontend-domain.example,https://your-render-static-site.onrender.com
# Google AI Studio API key (server-side only)
GEMINI_API_KEY=replace-with-your-gemini-api-key
CONTACT_EMAIL=
NCBI_API_KEY=
